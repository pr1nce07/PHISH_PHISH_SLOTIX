# Copy to .env (never commit .env). Placeholders only - no real secrets belong in this file.

TT_ENV=development                 # "production" turns on secure cookies, HSTS, admin MFA, and turns off docs + local login
TT_ORG_NAME=                       # optional: school name shown under the product name
TT_DATABASE_URL=sqlite:///./data/timetable.db
TT_COOKIE_SECURE=0                 # must be 1 behind HTTPS (default 1 in production)
TT_SESSION_MINUTES=480
TT_SESSION_IDLE_MINUTES=60
TT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000   # origins allowed to mint Clerk tokens (azp check)

# --- Clerk (Google sign-in + authenticator MFA) ---
# `clerk env pull --file .env` writes these for you.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME   # server-side only; never exposed to the browser
TT_LOCAL_LOGIN=1                   # username/password login for development and demo accounts (default 0 in production)
TT_REQUIRE_ADMIN_MFA=0             # 1 = administrators must sign in with a second factor (default 1 in production)

# --- solver limits ---
TT_SOLVER_MAX_SECONDS=60
TT_SOLVER_WORKERS=4
TT_MAX_QUEUED_RUNS=3
